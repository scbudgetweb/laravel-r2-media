{
    "name": "scbudgetweb/laravel-r2-media",
    "description": "Configurable Cloudflare R2 / Amazon S3 / local storage for Spatie Media Library, with an optional Filament settings page and a media migration command.",
    "type": "library",
    "license": "proprietary",
    "keywords": ["laravel", "cloudflare", "r2", "s3", "media-library", "filament"],
    "authors": [
        {
            "name": "Shaun Corness",
            "email": "shaun@budgetweb.online"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "spatie/laravel-medialibrary": "^11.0"
    },
    "require-dev": {
        "filament/filament": "^4.0|^5.0",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "suggest": {
        "filament/filament": "Required for the Media Storage settings page (^4.0|^5.0)."
    },
    "autoload": {
        "psr-4": {
            "Scbudgetweb\\R2Media\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Scbudgetweb\\R2Media\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Scbudgetweb\\R2Media\\R2MediaServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
